# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon (legacy) or publishable key. Safe to expose; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role (legacy) or secret key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://seanw.me
# IANA timezone used for daily analytics buckets and dates in the admin.
NEXT_PUBLIC_APP_TIMEZONE=America/Chicago

# Long random string shared with the GitHub keep-alive workflow. `openssl rand -hex 32`
CRON_SECRET=

# Optional extra lock: only these emails may use /tycho (comma separated).
ADMIN_EMAILS=
